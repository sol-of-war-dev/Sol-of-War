# Safe local development defaults. No credentials are needed for guest Free Play.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
PAYMENTS_MODE=simulation
FRONTPOT_STATE_DIR=.frontpot-state

# Optional wallet sign-in. Use a separate development Privy application.
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# PRIVY_CLIENT_ID=
# PRIVY_VERIFICATION_KEY=

# Admin access is disabled until verified wallet addresses are explicitly allowed.
# SOLSIEGE_ADMIN_WALLETS=

# Keep production credentials, wallet keyrings, RPC keys and backup keys outside Git.
# See PAYMENTS.md and OPERATIONS.md before configuring funded matches.

# User-owned wallet rollout stays off until provider and real-wallet checks pass.
# Requires Privy TEE user-owned wallets and identity tokens; no server/session signers.
# SOLSIEGE_USER_OWNED_WALLETS=enabled
# Retain SOLSIEGE_PLAYER_WALLETS=enabled and existing keyring/backups for legacy recovery.
# See USER_OWNED_WALLETS.md. Match pools remain custodial.
